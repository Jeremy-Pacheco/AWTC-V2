# Backend environment template. Copy it to `.env.development.local` (local
# development) or `.env.production.local` and fill in your own values.
# Those files are git-ignored: NEVER commit real secrets.
# Full reference: docs/deploy-demo.md ("Tabla de variables").

NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# --- Secrets (required). Generate each with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_SECRET=

# --- Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_awtc_development
DB_SSL=false
# DB_SSL_CA=

# --- Authentication: local (passwords in the DB) or ldap
AUTH_PROVIDER=local
# LDAP_URL=ldap://localhost:389
# LDAP_BASE_DN=dc=awtc,dc=com
# LDAP_ADMIN_DN=cn=admin,dc=awtc,dc=com
# LDAP_ADMIN_PASSWORD=

# --- Push notifications: npx --yes web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=you@example.com

# --- Optional
# STORAGE_PROVIDER=local          # or cloudinary (+ CLOUDINARY_URL)
# SESSION_COOKIE_SECURE=false     # true behind HTTPS
# DEMO_MODE=false
# USE_HTTPS=false
