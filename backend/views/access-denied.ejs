<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Access Denied - A Will To Change</title>
  <link rel="icon" type="image/png" href="/images/awtc-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font);
      background: var(--paper);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .error-container {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
      padding: 60px 40px;
      text-align: center;
      max-width: 500px;
      width: 100%;
    }

    .error-icon {
      font-size: 80px;
      color: #e53e3e;
      margin-bottom: 24px;
    }

    .error-title {
      font-size: 32px;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 16px;
    }

    .error-message {
      font-size: 16px;
      color: var(--text-2);
      line-height: 1.6;
      margin-bottom: 32px;
    }

    .error-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
      border: none;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-primary {
      background: var(--accent);
      color: var(--ink);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(18, 163, 111, 0.3);
    }

    .btn-secondary {
      background: var(--line);
      color: var(--ink-2);
    }

    .btn-secondary:hover {
      background: var(--gray-300);
      transform: translateY(-2px);
    }

    .user-info {
      background: var(--surface);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
      border-left: 4px solid var(--accent);
    }

    .user-info-label {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 4px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .user-info-value {
      font-size: 16px;
      color: var(--ink);
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-icon">
      <i class="fas fa-shield-alt"></i>
    </div>
    
    <h1 class="error-title">Access Denied</h1>
    
    <p class="error-message">
      Sorry, you don't have permission to access the admin dashboard. 
      This area is restricted to administrators only.
    </p>

    <% if (currentUser) { %>
      <div class="user-info">
        <div class="user-info-label">Logged in as</div>
        <div class="user-info-value"><%= currentUser.email %></div>
        <div class="user-info-label" style="margin-top: 8px;">Role</div>
        <div class="user-info-value"><%= currentUser.role || 'volunteer' %></div>
      </div>
    <% } %>

    <div class="error-buttons">
      <form method="POST" action="/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-sign-out-alt"></i>
          Log Out
        </button>
      </form>
      <a href="<%= frontendUrl || 'http://localhost:5173' %>" class="btn btn-secondary">
        <i class="fas fa-home"></i>
        Go to Home
      </a>
    </div>
  </div>
</body>
</html>
